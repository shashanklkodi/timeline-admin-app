      "icons": {
        "library": "lucide-react",
        "style": "stroke-1.5"
      }
    },
    "implementation_plan": {
      "phases": [
        {
          "name": "Setup & Theme",
          "description": "Install dependencies, configure Tailwind with new colors/fonts, set up React Router."
        },
        {
          "name": "Layout & Auth",
          "description": "Create SidebarLayout, LoginPage, and ProtectedRoute. Implement Dark/Light toggle."
        },
        {
          "name": "Dashboard & Widgets",
          "description": "Build the main dashboard with stats cards (Artifacts Count, Gallery Visits) using Recharts."
        },
        {
          "name": "Artifact Management",
          "description": "Create Data Table for artifacts with filtering. Create Add/Edit Artifact Form (use Shadcn Form)."
        },
        {
          "name": "Gallery Builder",
          "description": "Implement Drag-and-Drop gallery ordering using dnd-kit or react-beautiful-dnd."
        },
        {
          "name": "Media Library",
          "description": "Grid view of images with upload functionality."
        }
      ],
      "universal_guidelines": [
        "Use 'sonner' for all toast notifications.",
        "DO NOT use gradients for backgrounds. Stick to solid colors for the 'Archival' look.",
        "All interactive elements MUST have 'data-testid'.",
        "Use 'lucide-react' for icons.",
        "Ensure text contrast meets WCAG AA.",
        "Forms must use 'react-hook-form' with 'zod' validation.",
        "Tables should use 'tanstack/react-table' (Shadcn Table)."
      ]
    }
  }