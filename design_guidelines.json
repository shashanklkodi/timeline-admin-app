{
    "design_system": {
      "identity": {
        "name": "Museum Artifact CMS",
        "archetype": "The Curator's Desk",
        "vibe": "Archival, Precision, Timeless, High-Utility",
        "core_philosophy": "Content is the artifact. The UI is the frame. The frame must never distract from the artifact."
      },
      "typography": {
        "font_family": {
          "headings": "Playfair Display, serif",
          "body": "Manrope, sans-serif",
          "mono": "JetBrains Mono, monospace"
        },
        "scale": {
          "h1": "text-4xl md:text-5xl font-semibold tracking-tight leading-[1.1]",
          "h2": "text-3xl font-medium tracking-tight",
          "h3": "text-2xl font-medium",
          "body_lg": "text-lg leading-relaxed",
          "body_base": "text-base leading-relaxed text-muted-foreground",
          "caption": "text-xs uppercase tracking-widest font-semibold text-muted-foreground/80"
        },
        "imports": [
          "@import url('https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500&display=swap');"
        ]
      },
      "colors": {
        "palette": {
          "light": {
            "background": "0 0% 98%",
            "foreground": "240 10% 3.9%",
            "card": "0 0% 100%",
            "card_foreground": "240 10% 3.9%",
            "popover": "0 0% 100%",
            "popover_foreground": "240 10% 3.9%",
            "primary": "240 5.9% 10%",
            "primary_foreground": "0 0% 98%",
            "secondary": "240 4.8% 95.9%",
            "secondary_foreground": "240 5.9% 10%",
            "muted": "240 4.8% 95.9%",
            "muted_foreground": "240 3.8% 46.1%",
            "accent": "24 95% 53%",
            "accent_foreground": "0 0% 98%",
            "destructive": "0 84.2% 60.2%",
            "destructive_foreground": "0 0% 98%",
            "border": "240 5.9% 90%",
            "input": "240 5.9% 90%",
            "ring": "240 10% 3.9%"
          },
          "dark": {
            "background": "240 10% 3.9%",
            "foreground": "0 0% 98%",
            "card": "240 10% 3.9%",
            "card_foreground": "0 0% 98%",
            "popover": "240 10% 3.9%",
            "popover_foreground": "0 0% 98%",
            "primary": "0 0% 98%",
            "primary_foreground": "240 5.9% 10%",
            "secondary": "240 3.7% 15.9%",
            "secondary_foreground": "0 0% 98%",
            "muted": "240 3.7% 15.9%",
            "muted_foreground": "240 5% 64.9%",
            "accent": "24 95% 53%",
            "accent_foreground": "0 0% 98%",
            "destructive": "0 62.8% 30.6%",
            "destructive_foreground": "0 0% 98%",
            "border": "240 3.7% 15.9%",
            "input": "240 3.7% 15.9%",
            "ring": "240 4.9% 83.9%"
          }
        },
        "usage": {
          "primary_action": "bg-primary text-primary-foreground hover:bg-primary/90",
          "accent_action": "bg-accent text-accent-foreground hover:bg-accent/90 (Use sparingly for 'Create' or 'Publish')",
          "surface": "bg-card border border-border"
        }
      },
      "components": {
        "buttons": {
          "style": "rounded-sm font-medium tracking-wide transition-all duration-200 active:scale-95",
          "variants": {
            "default": "bg-primary text-primary-foreground shadow-sm hover:bg-primary/90",
            "outline": "border border-input bg-background hover:bg-accent hover:text-accent-foreground",
            "ghost": "hover:bg-accent hover:text-accent-foreground",
            "link": "text-primary underline-offset-4 hover:underline"
          }
        },
        "cards": {
          "style": "rounded-none border border-border bg-card text-card-foreground shadow-sm"
        },
        "inputs": {
          "style": "rounded-sm border-input bg-transparent shadow-sm transition-colors file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50"
        },
        "layout": {
          "sidebar": "w-64 border-r bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60",
          "header": "h-14 border-b bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60 sticky top-0 z-50",
          "container": "container mx-auto p-8 max-w-7xl"
        }
      },
      "animations": {
        "micro": {
          "hover_lift": "transition-transform duration-200 hover:-translate-y-[2px]",
          "fade_in": "animate-in fade-in zoom-in-95 duration-200"
        }
      }
    },
    "layout_structure": {
      "dashboard": "grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6",
      "bento_grid": {
        "hero": "col-span-full md:col-span-2 lg:col-span-3 row-span-2",
        "sidebar_widget": "col-span-1 row-span-2",
        "stat_card": "col-span-1"
      }
    },
